<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<title>Yearning · wm 生日快乐 🌙</title>
<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}
body{
    margin:0;
    height:100vh;
    overflow:hidden;
    display:flex;
    justify-content:center;
    align-items:center;
    font-family:"Microsoft YaHei",system-ui,sans-serif;
    background:
    radial-gradient(circle at 15% 15%, #fff0d6 0%, transparent 42%),
    radial-gradient(circle at 85% 20%, #ffe2c2 0%, transparent 48%),
    linear-gradient(135deg, #fff6e4, #ffe4cf);
}
.card{
    width:330px;
    padding:30px 25px;
    background:
    linear-gradient(180deg, #ffffff 0%, #fffbf2 100%);
    border-radius:28px;
    text-align:center;
    box-shadow:
    0 10px 30px rgba(255, 175, 110, .28),
    0 2px 8px rgba(255, 200, 160, .22);
    z-index:5;
    position:relative;
}
.card::before,
.card::after{
    content:"";
    position:absolute;
    border-radius:50%;
    filter:blur(20px);
    opacity:.45;
    z-index:-1;
}
.card::before{
    width:190px;
    height:190px;
    background:#ffd4a8;
    top:-40px;
    left:-40px;
}
.card::after{
    width:150px;
    height:150px;
    background:#ffc99a;
    bottom:-30px;
    right:-30px;
}
.heart{
    font-size:52px;
    animation:beat 1.2s infinite;
    background:linear-gradient(135deg, #7fa6c2, #b9a7d6);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    filter:drop-shadow(0 4px 6px rgba(140, 170, 200, .35));
}
@keyframes beat{
    50%{
        transform:scale(1.12);
    }
}
h1{
    background:linear-gradient(135deg, #7fa6c2, #b9a7d6);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    font-size:32px;
    letter-spacing:1px;
}
h2{
    color:#d48a5a;
}
.text{
    color:#c97a4a;
    line-height:28px;
    min-height:50px;
}
.letter{
    margin-top:18px;
    padding:16px;
    background:
    linear-gradient(180deg, #fff7e8, #ffeeda);
    border:1px solid #ffdfbf;
    border-radius:18px;
    color:#a66640;
    font-size:15px;
    line-height:26px;
}
button{
    border:none;
    border-radius:40px;
    font-size:20px;
    padding:12px 28px;
    margin:15px;
    cursor:pointer;
}
#yes{
    background:
    linear-gradient(135deg, #8fb0d1, #b9a7d6);
    color:white;
    transition:transform .4s ease;
    box-shadow:
    0 8px 20px rgba(140, 170, 200, .4);
}
.love{
    position:absolute;
    top:-30px;
    z-index:1;
    animation:fall 5s linear forwards;
}
@keyframes fall{
    to{
        transform:translateY(110vh);
        opacity:0;
    }
}
.fire{
    position:absolute;
    font-size:28px;
    animation:boom 1s forwards;
}
@keyframes boom{
    0%{
        transform:scale(.2);
        opacity:1;
    }
    100%{
        transform:scale(3);
        opacity:0;
    }
}
</style>
</head>
<body>
<div class="card">
<div class="heart">
🌙
</div>
<h1>
Yearning · wm 🌙
</h1>
<div class="text" id="text"></div>
<div class="letter">
小吴同学，生日快乐。<br><br>
不必强迫自己热闹。愿新的一岁，你内心的褶皱都能慢慢舒展，<br>
在自己的节奏里，寻得安宁，守住心底那份独属于你的温柔与清醒。
</div>
<button id="yes">
收下祝福 🌙
</button>
</div>
<script>
let words="生日快乐，wm。新的一岁，愿你拥有属于自己的安静与温柔，不必匆忙，自在从容。";
let index=0;
function typing(){
    if(index<words.length){
        let t=document.getElementById("text");
        t.innerHTML+=
        words[index]=="\n"
        ?
        "<br>"
        :
        words[index];
        index++;
        setTimeout(typing,100);
    }
}
typing();
let yes=document.getElementById("yes");
let scale=1;
yes.onclick=function(){
    scale+=0.08;
    if(scale<1.65){
        yes.style.transform="scale("+scale+")";
    }
    if(scale>=1.65){
        document.querySelector(".card").innerHTML=
        `
        <div class="heart">
        🪐
        </div>
        <h1>
        Yearning · wm 🌙
        </h1>
        <h2>
        祝福送达 ✨
        </h2>
        <p>
        愿你常有独处的安稳，
        <br>
        内心自洽，在自己的节奏里慢慢发光。
        </p>
        `;
        fireworks();
    }
};
setInterval(function(){
    let love=document.createElement("div");
    love.className="love";
    love.innerHTML=["🕯️","🪐","☁️","🌷","🌙"][Math.floor(Math.random()*5)];
    love.style.left=Math.random()*100+"vw";
    love.style.fontSize=(18+Math.random()*15)+"px";
    document.body.appendChild(love);
    setTimeout(function(){
        love.remove();
    },5000);
    let list=document.querySelectorAll(".love");
    if(list.length>20){
        list[0].remove();
    }
},500);
function fireworks(){
    for(let i=0;i<25;i++){
        setTimeout(function(){
            let f=document.createElement("div");
            f.className="fire";
            f.innerHTML=["🪐","🕯️","☁️","🌷","🌙"][Math.floor(Math.random()*5)];
            f.style.left=Math.random()*100+"vw";
            f.style.top=Math.random()*80+"vh";
            document.body.appendChild(f);
            setTimeout(function(){
                f.remove();
            },1000);
        },i*100);
    }
}
</script>
</body>
</html>
